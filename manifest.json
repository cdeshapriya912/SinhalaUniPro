{
  "manifest_version": 3,
  "name": "SinhalaUniPro - Sinhala Unicode Converter",
  "version": "1.0.0",
  "description": "Real-time Singlish to Sinhala Unicode converter based on the UCSC LTRL standard with scheme reference, instant copy, and full editor.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SinhalaUniPro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png",
      "500": "icons/SinhalaUniPro.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardWrite",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["converter.js", "dictionary_data.js", "spellchecker.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open SinhalaUniPro Popup"
    },
    "toggle-inline-sinhala": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Toggle Sinhala / English Inline Typing"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "500": "icons/SinhalaUniPro.png"
  }
}
